{
  "name": "dsh-ban-hammer",
  "version": "0.2.0",
  "description": "Region-gated account bans for DeepSeek Harness: scores local region signals, can remove API keys and sign-in credentials, moves configured files to a local trash, and gives the agent a ban tool.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ban",
    "region"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/region.test.mjs test/host.test.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
